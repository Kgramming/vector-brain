# Vector-Brain environment template.
# Copy to backend/.env and fill in. NEVER commit a real .env.

# --- Database (PostgreSQL + pgvector) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://vectorbrain:vectorbrain@localhost:5432/vectorbrain

# --- Groq (https://console.groq.com/keys) ---
# Leave empty to run in MOCK mode (offline answers, no key needed).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Embeddings (384-dim; must stay 384 to match the pgvector schema) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# MOCK_EMBEDDINGS=true uses deterministic hash embeddings (tests/dev without model download)
MOCK_EMBEDDINGS=false

# --- Retrieval ---
TOP_K=6
SCORE_THRESHOLD=0.30

# --- Ingestion ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_UPLOAD_MB=50
UPLOAD_DIR=./uploads

# --- App ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
