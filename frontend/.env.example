# Direct backend URL for the browser. Leave unset to use relative /api URLs,
# which the Vite dev server proxies to VB_BACKEND_URL (default
# http://localhost:8000 — see vite.config.js).
#
# Set this when NOT using the Vite dev proxy, e.g. serving a production
# build statically while the API runs elsewhere:
# VITE_API_URL=http://127.0.0.1:8001
